{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared base: when updates appear and which of them merge themselves. Project type presets extend this.",
  "extends": [
    "config:best-practices",
    "security:openssf-scorecard",
    "customManagers:githubActionsVersions"
  ],
  "ignorePresets": [":pinDevDependencies"],
  "timezone": "Europe/Berlin",
  "labels": ["dependencies"],
  "branchPrefix": "deps/",
  "npmrc": "allow-remote=all\nmin-release-age=3\nmin-release-age-exclude[]=@ramen-suite/*\nmin-release-age-exclude[]=@sushi-kit/*",
  "separateMinorPatch": true,
  "minimumReleaseAge": "3 days",
  "schedule": ["* 1-4 * * 1"],
  "platformAutomerge": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "addLabels": ["security"]
  },

  "packageRules": [
    {
      "description": "Patches, pins and digests merge themselves on weekday mornings",
      "matchUpdateTypes": ["patch", "pin", "pinDigest", "digest"],
      "automerge": true,
      "automergeType": "branch",
      "schedule": ["* 2-7 * * 1-5"],
      "automergeSchedule": ["* 2-8 * * 1-5"]
    },
    {
      "description": "Minors are a pull request on Monday mornings",
      "matchUpdateTypes": ["minor"],
      "automerge": false,
      "schedule": ["* 2-7 * * 1"]
    },
    {
      "description": "Majors are a pull request on the first of the month",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "schedule": ["* 2-7 1 * *"],
      "addLabels": ["major"]
    },
    {
      "description": "Group action updates on one schedule so mixed update types share a branch",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "schedule": ["* 2-7 * * 1"],
      "automergeSchedule": ["* 2-7 * * 1"]
    },
    {
      "description": "RAMEN-Suite/ramen-workflows is ours (immutable releases with provenance): no cooldown, no weekly slot, outside the action group",
      "matchPackageNames": ["RAMEN-Suite/ramen-workflows"],
      "minimumReleaseAge": null,
      "groupName": null,
      "schedule": ["at any time"],
      "automergeSchedule": ["at any time"]
    },
    {
      "description": "Lock file maintenance (weekly from config:best-practices, monthly in npm) has no release dates for Renovate's age check, so it waited forever. The cooldown comes from npm itself: min-release-age=3 in npmrc above, for every transitive package too.",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    }
  ]
}
